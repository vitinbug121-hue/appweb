# Asaas
ASAAS_API_KEY=
ASAAS_ENV=sandbox
# Opção navegador (Selenium): perfil dedicado do Chrome com a sessão do Asaas
ASAAS_PERFIL_CHROME=
ASAAS_HEADLESS=1
CHROMEDRIVER_PATH=
CHROME_BINARY=
# Situação do Asaas que conta como paga
ASAAS_SITUACOES_PAGAS=recebida
